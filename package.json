{
  "name": "new-audio-360",
  "description": "Premium music player with studio-quality audio processing",
  "author": "The Team 360 <dhairyashah@theteam360.com>",
  "main": "client/index.js",
  "version": "28.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN npx expo start --localhost --web --port 5000",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web:build": "npx expo export --platform web",
    "web:serve": "npx serve dist",
    "windows:icons": "node windows/scripts/generate-icons.js assets/images/icon.png",
    "electron:dev": "npm run web:build && electron electron/main.js",
    "electron:build": "npm run web:build && electron-builder --config electron/electron-builder.yml",
    "electron:build:win": "npm run web:build && electron-builder --config electron/electron-builder.yml --win",
    "electron:build:appx": "npm run web:build && electron-builder --config electron/electron-builder.yml --win appx"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/slider": "4.5.5",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@tanstack/react-query": "^5.90.7",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "audio-effects": "file:modules/audio-effects",
    "browser-id3-writer": "^6.3.1",
    "expo": "~53.0.0",
    "expo-application": "^7.0.8",
    "expo-asset": "~11.1.7",
    "expo-audio": "~0.4.9",
    "expo-auth-session": "~6.2.1",
    "expo-av": "~15.1.7",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "^0.14.8",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "^19.0.21",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-location": "~18.1.6",
    "expo-media-library": "~17.1.7",
    "expo-navigation-bar": "^5.0.10",
    "expo-notifications": "~0.31.4",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-audio-api": "^0.11.1",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-keyboard-controller": "^1.20.6",
    "react-native-reanimated": "3.17.5",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-track-player": "^4.1.1",
    "react-native-web": "~0.20.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "22.14.0",
    "@types/react": "~19.0.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-prettier": "^5.5.4",
    "patch-package": "^8.0.1",
    "prettier": "3.6.2",
    "typescript": "~5.8.3"
  },
  "private": true,
  "expo": {
    "install": {},
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "audio-effects"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
