{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "SOUNDCLOUD_CLIENT_ID": "@SOUNDCLOUD_CLIENT_ID",
        "SOUNDCLOUD_CLIENT_SECRET": "@SOUNDCLOUD_CLIENT_SECRET"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "ios": {
        "simulator": true,
        "credentialsSource": "remote"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview",
        "SOUNDCLOUD_CLIENT_ID": "@SOUNDCLOUD_CLIENT_ID",
        "SOUNDCLOUD_CLIENT_SECRET": "@SOUNDCLOUD_CLIENT_SECRET"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "ios": {
        "credentialsSource": "remote"
      }
    },
    "production": {
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/release/mapping.txt"
      ],
      "env": {
        "APP_ENV": "production",
        "SOUNDCLOUD_CLIENT_ID": "@SOUNDCLOUD_CLIENT_ID",
        "SOUNDCLOUD_CLIENT_SECRET": "@SOUNDCLOUD_CLIENT_SECRET"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "ios": {
        "credentialsSource": "remote"
      },
      "autoIncrement": false
    },
    "production-apk": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "production",
        "SOUNDCLOUD_CLIENT_ID": "@SOUNDCLOUD_CLIENT_ID",
        "SOUNDCLOUD_CLIENT_SECRET": "@SOUNDCLOUD_CLIENT_SECRET"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "testing": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "testing",
        "SOUNDCLOUD_CLIENT_ID": "@SOUNDCLOUD_CLIENT_ID",
        "SOUNDCLOUD_CLIENT_SECRET": "@SOUNDCLOUD_CLIENT_SECRET"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "$EXPO_APPLE_ID",
        "ascAppId": "$EXPO_ASC_APP_ID",
        "appleTeamId": "$EXPO_APPLE_TEAM_ID"
      }
    }
  }
}
