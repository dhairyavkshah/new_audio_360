# Ignore unnecessary files for EAS build
.git
.github
docs
*.md
!README.md
.env*
.replit
replit.nix
replit.md
dist
*.log
.expo
.idea
.vscode
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage
generated-icon.png

# Large folders - EAS will run npm install, don't upload node_modules
node_modules

# Attached assets - test files, screenshots, audio samples
attached_assets/
attached_assets/**
attached_assets/*.mp3
attached_assets/*.txt

# Test audio files - not needed for build
public/audio
public/audio/**
*.mp3
