entrypoint = "README.md"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[env]
PORT = "5000"

[agent]
stack = "EXPO"
expertMode = true

[workflows]

[userenv]

[userenv.shared]
EXPO_PUBLIC_UPI_ID = "dhairyavkshah@icici"
EXPO_PUBLIC_UPI_PHONE = "+919722523691"
EXPO_PUBLIC_PAYPAL_USERNAME = "dhairyavkshah"
EXPO_PUBLIC_PAYEE_NAME = "Dhairyavk Shah"
