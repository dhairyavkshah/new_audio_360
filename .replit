entrypoint = "README.md"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8082
externalPort = 3002

[env]
PORT = "5000"

[agent]
stack = "EXPO"
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Android Build Info"

[[workflows.workflow]]
name = "Android Build Info"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"=== New Audio 360 - Native Android App ===\" && echo \"\" && echo \"This is a pure native Android project. Build using:\" && echo \"\" && echo \"  cd android && ./gradlew assembleDebug\" && echo \"\" && echo \"Or push to GitHub to trigger the build workflow.\" && echo \"\" && echo \"Project structure:\" && ls -la android/app/src/main/java/com/newaudio360/app/ 2>/dev/null || echo \"Run 'cd android && ./gradlew tasks' to see available build tasks\""

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
EXPO_PUBLIC_UPI_ID = "dhairyavkshah@icici"
EXPO_PUBLIC_UPI_PHONE = "+919722523691"
EXPO_PUBLIC_PAYPAL_USERNAME = "dhairyavkshah"
EXPO_PUBLIC_PAYEE_NAME = "Dhairyavk Shah"
